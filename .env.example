# Required for WalletConnect-based mobile wallet flows, including Bitget Wallet mobile.
# Create one at https://cloud.walletconnect.com and set this in your deployment environment,
# including Vercel Project Settings -> Environment Variables.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Direct Mezo RPC endpoints used by the dApp.
NEXT_PUBLIC_MEZO_TESTNET_RPC_HTTP=https://rpc.test.mezo.org
NEXT_PUBLIC_MEZO_MAINNET_RPC_HTTP=https://rpc.mezo.org

# Optional concentrated-liquidity route search and execution limits.
NEXT_PUBLIC_SWAP_MAX_HOPS=3
NEXT_PUBLIC_SWAP_MAX_CANDIDATE_ROUTES=64
NEXT_PUBLIC_SWAP_QUOTE_TTL_SECONDS=30

# Current Aurove protocol addresses used by Earn.
NEXT_PUBLIC_VEBTC_ADDRESS=
NEXT_PUBLIC_VEMEZO_ADDRESS=
NEXT_PUBLIC_LEDGER_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_ID20_FACTORY_ADDRESS=

# Supabase public client settings.
# For local Supabase, `supabase status --output env` prints matching values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key for server-only privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle ORM and Drizzle Kit use this direct Postgres connection string.
# For local Supabase, the default connection is usually:
# postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Select the dapp's active chain. Production defaults to testnet when this is unset;
# set it explicitly in every deployment environment.
NEXT_PUBLIC_APP_ENV=local

# Server-only HMAC secret for POST /api/internal/cron.
# Must be a long random string and match the scheduler that signs requests.
CRON_INTERNAL_SECRET=

# Server-only shared secret for POST /api/internal/events.
# Use the same value in your webhook sender's Authorization Bearer token or secret header.
EVENTS_WEBHOOK_SECRET=

# Optional custom header name for webhook secret authentication.
# Defaults to x-aurove-webhook-secret when unset.
EVENTS_WEBHOOK_AUTH_HEADER=

# Maximum MUSD value that one Academy swap or fee-collection event may use for
# points valuation. Suspicious events above this circuit breaker are skipped.
ACADEMY_MAX_VALUATION_MUSD=1000000

# Internal local relay settings for forwarding Hardhat logs into /api/internal/events.
# The relay uses the local dApp URL by default, resolves the deployment network from the
# connected RPC chain ID, and discovers deployment JSONs from the matching core deployment
# folders.
EVENTS_WEBHOOK_URL=http://127.0.0.1:3000/api/internal/events
EVENTS_RELAY_RPC_URL=http://127.0.0.1:8545
# Emergency fallback start block if the manager deployment block cannot be resolved.
EVENTS_RELAY_START_BLOCK=
EVENTS_RELAY_POLL_INTERVAL_MS=3000
# Maximum block span to scan per eth_getLogs call.
EVENTS_RELAY_MAX_BLOCK_DISTANCE=250
# Maximum request body size for webhook intake in bytes.
EVENTS_WEBHOOK_MAX_BODY_BYTES=2097152
# Optional checkpoint file path. Defaults to .tmp/internal-events-relay-state.json at repo root.
# The file stores per-chain cursors and replayable event caches under a chains[chainId] map.
EVENTS_RELAY_STATE_FILE=
# Optional comma-separated contract addresses to watch instead of auto-discovered deployments.
EVENTS_RELAY_ADDRESSES=
